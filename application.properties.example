# ==============================================================
# APPLICATION PROPERTIES (TEMPLATE)
# ==============================================================
# DO NOT COMMIT SECRETS TO VERSION CONTROL.
# Copy this file to application.properties and replace the placeholder values.

# ===============================
# 1. SERVER CONFIGURATION
# ===============================
server.port=8080

# ===============================
# 2. DATABASE CONFIGURATION (MySQL)
# ===============================
spring.datasource.url=jdbc:mysql://localhost:3306/badminton_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
spring.datasource.username=YOUR_DB_USERNAME
spring.datasource.password=YOUR_DB_PASSWORD
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# ===============================
# 3. JPA & HIBERNATE CONFIGURATION
# ===============================
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect

# ===============================
# 4. REDIS CONFIGURATION (Caching / Sessions)
# ===============================
spring.data.redis.host=localhost
spring.data.redis.port=6379

# ===============================
# 5. SECURITY & JWT CONFIGURATION
# ===============================
# Generate a strong Base64 encoded secret key for production
jwt.secret=YOUR_BASE64_ENCODED_JWT_SECRET_KEY
jwt.refresh.expiration=604800000

# ===============================
# 6. EMAIL CONFIGURATION (SMTP)
# ===============================
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=YOUR_EMAIL@gmail.com
spring.mail.password=YOUR_APP_SPECIFIC_PASSWORD
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
spring.mail.properties.mail.smtp.starttls.required=true

# ===============================
# 7. VIETQR CONFIGURATION (Bank Info)
# ===============================
# Replace with your actual Bank BIN, Account Number, and Account Name
vietqr.bank.bin=970407
vietqr.bank.account-no=YOUR_ACCOUNT_NUMBER
vietqr.bank.account-name=YOUR_ACCOUNT_NAME

# ===============================
# 8. PAYOS CONFIGURATION (Payment Gateway)
# ===============================
client.id=YOUR_PAYOS_CLIENT_ID
api.key=YOUR_PAYOS_API_KEY
checksum.key=YOUR_PAYOS_CHECKSUM_KEY

# ===============================
# 9. JMS (ActiveMQ Artemis Embedded for Async Queues)
# ===============================
spring.artemis.mode=embedded
spring.artemis.embedded.enabled=true
spring.artemis.embedded.queues=emailQueue
spring.artemis.packages.trust-all=true
